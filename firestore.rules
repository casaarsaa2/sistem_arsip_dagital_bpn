rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'password');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getRole() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) ? get(userPath).data.role : null;
    }

    function isRole(role) {
      return isSignedIn() && getRole() == role;
    }

    function isSuperAdmin() {
      return isRole('SUPER_ADMIN');
    }

    function isAdmin() {
      let role = getRole();
      return isSignedIn() && (role == 'SUPER_ADMIN' || role == 'ADMIN');
    }

    function isStaff() {
      let role = getRole();
      return isSignedIn() && (role == 'SUPER_ADMIN' || role == 'ADMIN' || role == 'PETUGAS_ARSIP');
    }

    // Archive Validation
    function isValidArchive(data) {
      return data.type in ['BUKU_TANAH', 'WARKAH', 'SURAT_UKUR'] &&
             data.namaPemegangHak is string && data.namaPemegangHak.size() > 0 &&
             data.namaPemegangHak.size() <= 255;
    }

    match /archives/{archiveId} {
      allow get: if isStaff();
      allow list: if isStaff();
      allow create: if isStaff() && isValidArchive(incoming());
      allow update: if isStaff() && isValidArchive(incoming());
      allow delete: if isAdmin();
    }

    // Loan Validation
    function isValidLoan(data) {
      return data.archiveId is string && data.borrowerName is string &&
             data.status in ['Active', 'Returned'];
    }

    match /loans/{loanId} {
      allow get: if isStaff();
      allow list: if isStaff();
      allow create: if isStaff() && isValidLoan(incoming());
      allow update: if isStaff() && isValidLoan(incoming());
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      // Allow get if it's your own UID, or if the email matches (for claiming), or if you're staff
      allow get: if isSignedIn() && (
        request.auth.uid == uid || 
        isStaff() || 
        (resource != null && (resource.data.email == request.auth.token.email || resource.id == request.auth.uid))
      );
      
      // Only staff can list all users
      allow list: if isStaff();
      
      // Allow creation of your own profile
      allow create: if isSignedIn() && (
        isAdmin() || 
        request.auth.uid == uid
      );
      
      // Allow update of your own profile (except role, which only admins can change)
      allow update: if isSignedIn() && (
        isAdmin() || 
        (request.auth.uid == uid && incoming().role == resource.data.role)
      );
      
      // Allow deletion of your own profile OR the pre-profile that matches your email
      allow delete: if (
        isAdmin() && resource.data.role != 'SUPER_ADMIN'
      ) || (
        isSignedIn() && (resource.data.email == request.auth.token.email || resource.id == request.auth.uid)
      );
    }

    match /locations/{locationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
